# Gradle and Kotlin build state
.gradle/
.kotlin/
/build
/captures
.externalNativeBuild
.cxx

# Machine-specific SDK path (Android Studio regenerates it)
local.properties

# Android Studio: Gradle files are the source of truth, so only the shared code style is kept
*.iml
/.idea/*
!/.idea/codeStyles/

# Built apps and signing keys must never be committed
*.apk
*.aab
*.jks
*.keystore
/app/release/

# Background music is copyrighted and this repo is public: the track stays on the developer's machine.
# Drop a licensed file at app/src/main/assets/music/game_theme.mp3 to hear it; the game is silent without it.
/app/src/main/assets/music/
